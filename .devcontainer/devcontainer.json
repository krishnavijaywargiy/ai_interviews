{
    "name": "AI Engineer Coding Interview",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "github.copilot.enable": {
                    "*": false
                },
                "github.copilot.editor.enableAutoCompletions": false,
                "editor.inlineSuggest.enabled": false
            }
        }
    },
    "postCreateCommand": "python3 -c 'import pathlib, sysconfig; p = pathlib.Path(sysconfig.get_path(\"stdlib\")) / \"EXTERNALLY-MANAGED\"; p.touch()'"
}
